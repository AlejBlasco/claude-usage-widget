   las dos está activa en cada momento del ciclado. *@
@namespace ClaudeMeter.Desktop.Tests.Navigation
@using ClaudeMeter.Desktop.Navigation
@implements IWidgetScreen

<span data-testid="dummy-screen">@ScreenId:@State.Session.PercentageUsed</span>

@code {
