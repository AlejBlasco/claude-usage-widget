<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Debe coincidir con el TFM de Desktop (net10.0-windows) para poder referenciarlo. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Sdk="Microsoft.NET.Sdk.Razor" (migrado en fase de Testing, ver
         docs/sdlc/testing/f1-widget-visual-base.md) es el requisito oficial
         de bUnit para proyectos de test que renderizan componentes Razor
         (UsageBar/UsagePage). Este proyecto no define sus propios .razor,
         solo referencia los de ClaudeMeter.Desktop. -->
    <!-- Migración a .NET 10 (issue #37): con el SDK 10 el proyecto de test
         descubre los static web assets del paquete
         Microsoft.AspNetCore.Components.WebView (blazor.modules.json) tanto
         por su propia referencia transitiva como a través de Desktop, y
         falla con "Conflicting assets with the same target path". Los tests
         bUnit no sirven contenido web, así que se desactiva la
         infraestructura de static web assets en este proyecto. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.11.3" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClaudeMeter.Desktop\ClaudeMeter.Desktop.csproj" />
  </ItemGroup>

</Project>
