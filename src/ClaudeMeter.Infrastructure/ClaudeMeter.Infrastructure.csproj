<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\ClaudeMeter.Application\ClaudeMeter.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Última versión estable de la serie 10.0.x (verificada en
         https://api.nuget.org/v3-flatcontainer/microsoft.extensions.logging.abstractions/index.json),
         alineada con el TFM net10.0 fijado por Directory.Build.props
         (migración a .NET 10, issue #37). Solo esta abstracción entra en
         Infrastructure — nunca Serilog concreto (Clean Architecture, ver
         documento de diseño de F2). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <!-- US-1 (F6): versionado automático. Ver el comentario completo en
         ClaudeMeter.Domain.csproj (misma desviación del documento de
         diseño: PackageReference repetido por proyecto en vez de
         centralizado en Directory.Build.props). -->
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Permite que ClaudeMeter.Infrastructure.Tests use el constructor
         interno de CredentialsFileTokenProvider (ruta de fichero
         inyectable solo para tests, sin exponerla públicamente) y el
         constructor interno de RetryingUsageDataSource (función de espera
         inyectable, F2/US-2). -->
    <InternalsVisibleTo Include="ClaudeMeter.Infrastructure.Tests" />
  </ItemGroup>
</Project>
