<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- F3/Ciclo B: icono de bandeja (US-2, issue #17) — NotifyIcon/
         ContextMenuStrip/ToolStripMenuItem llegan con esta propiedad como
         parte del framework compartido Microsoft.WindowsDesktop.App ya
         referenciado por UseWPF=true, sin PackageReference nuevo (ver
         Technology Choices del documento de diseño). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Requerido por el SDK de Razor para resolver correctamente el
         namespace de los .razor nuevos bajo Pages/ (workaround documentado
         por Microsoft para alojar Blazor en un proyecto WPF). -->
    <RootNamespace>ClaudeMeter.Desktop</RootNamespace>
    <!-- US-2 (F6, issue #25): Program.cs pasa a ser el punto de entrada
         real (Main() explícito, requerido para invocar
         VelopackApp.Build().Run() como primera línea, antes de construir
         App; ver Program.cs y el ItemGroup de App.xaml más abajo). -->
    <StartupObject>ClaudeMeter.Desktop.Program</StartupObject>
    <!-- Icono del ejecutable: lo usan el Explorador, los accesos directos y,
         vía Icon.ExtractAssociatedIcon, el icono de bandeja (TrayIconService). -->
    <ApplicationIcon>Assets\claudemeter.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeMeter.Application\ClaudeMeter.Application.csproj" />
    <ProjectReference Include="..\ClaudeMeter.Infrastructure\ClaudeMeter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- US-2 (F6, issue #25): App.xaml deja de ser ApplicationDefinition
         (que generaría su propio Main() y ocultaría la posibilidad de
         ejecutar código, como VelopackApp.Build().Run(), antes de
         construir App) y pasa a compilarse como una Page normal, técnica
         oficial de Velopack para WPF (ver documento de diseño, Technology
         Choices). -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <!-- Serie 10.0.x de Microsoft.AspNetCore.Components.WebView.Wpf, alineada
         con el TFM net10.0-windows fijado por Directory.Build.props (migración
         a .NET 10 LTS, issue #37). Última estable verificada en
         https://api.nuget.org/v3-flatcontainer/microsoft.aspnetcore.components.webview.wpf/index.json. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.120" />

    <!-- F2 (US-3, logging estructurado). Serilog y Serilog.Sinks.File versionan
         de forma independiente al TFM de .NET (última estable real verificada
         en api.nuget.org). Serilog.Extensions.Logging y Microsoft.Extensions.Logging
         se alinean con .NET 10 (issue #37). -->
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Serilog.Extensions.Logging: 10.0.0 es la última estable y su serie
         acompaña a Microsoft.Extensions.* 10.x. -->
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />

    <!-- Microsoft.Extensions.Logging: última estable de la serie 10.0.x. -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />

    <!-- US-1 (F6): versionado automático. Ver el comentario completo en
         ClaudeMeter.Domain.csproj (misma desviación del documento de
         diseño: PackageReference repetido por proyecto en vez de
         centralizado en Directory.Build.props). -->
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" PrivateAssets="all" />

    <!-- US-2/US-3 (F6, issues #25/#26): empaquetado del instalador
         (VelopackApp.Build().Run() en Program.cs) y auto-actualización
         (AppUpdateService/UpdateManager+GithubSource). Última estable
         verificada en api.nuget.org al implementar: 1.2.158. -->
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <ItemGroup>
    <!-- Permite que ClaudeMeter.Desktop.Tests (bUnit, migración pendiente a
         Microsoft.NET.Sdk.Razor en la fase de Testing) invoque los
         miembros internal de UsagePollingCoordinator/UsagePage
         (PollOnceForTestsAsync, ApplyForTests, etc.) sin esperar 60s reales
         por ciclo de test — mismo patrón ya usado por
         ClaudeMeter.ConsoleApp con ClaudeMeter.Console.Tests. -->
    <InternalsVisibleTo Include="ClaudeMeter.Desktop.Tests" />
  </ItemGroup>

</Project>
