<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- F3/Ciclo B: icono de bandeja (US-2, issue #17) — NotifyIcon/
         ContextMenuStrip/ToolStripMenuItem llegan con esta propiedad como
         parte del framework compartido Microsoft.WindowsDesktop.App ya
         referenciado por UseWPF=true, sin PackageReference nuevo (ver
         Technology Choices del documento de diseño). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Requerido por el SDK de Razor para resolver correctamente el
         namespace de los .razor nuevos bajo Pages/ (workaround documentado
         por Microsoft para alojar Blazor en un proyecto WPF). -->
    <RootNamespace>ClaudeMeter.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeMeter.Application\ClaudeMeter.Application.csproj" />
    <ProjectReference Include="..\ClaudeMeter.Infrastructure\ClaudeMeter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Última versión estable 8.x disponible en NuGet.org en el momento de
         implementar (verificada en https://api.nuget.org): 8.0.100, única
         compatible con el TFM net8.0-windows ya fijado por
         Directory.Build.props (las series 9.x/10.x exigen net9.0-windows/
         net10.0-windows). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.100" />

    <!-- F2 (US-3, logging estructurado). El documento de diseño fija la
         serie 8.0.x para los 5 paquetes nuevos, pero al verificar en
         api.nuget.org en el momento de implementar, dos de ellos nunca
         publicaron una versión estable 8.0.x (versionan de forma
         independiente al TFM de .NET, no como Microsoft.Extensions.*):
         se usa entonces su última versión estable real, compatible con
         net8.0-windows por multi-targeting (ver desviación documentada en
         el resumen de implementación). -->

    <!-- Serilog (núcleo): la serie de versión de este paquete nunca ha
         llegado a 8.x (va de 1.x a 4.x) — última estable real verificada
         en https://api.nuget.org/v3-flatcontainer/serilog/index.json. -->
    <PackageReference Include="Serilog" Version="4.4.0" />

    <!-- Serilog.Sinks.File: el 8.0.0 de este paquete solo existe como
         prerelease ("-dev-*"/"-nblumhardt-*"), nunca se publicó estable;
         última estable real verificada en
         https://api.nuget.org/v3-flatcontainer/serilog.sinks.file/index.json. -->
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Serilog.Extensions.Logging: este sí publicó 8.0.0 estable (coincide
         con la serie 8.0.x asumida por el diseño) — verificado en
         https://api.nuget.org/v3-flatcontainer/serilog.extensions.logging/index.json. -->
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />

    <!-- Microsoft.Extensions.Logging: última estable 8.0.x verificada en
         https://api.nuget.org/v3-flatcontainer/microsoft.extensions.logging/index.json. -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Permite que ClaudeMeter.Desktop.Tests (bUnit, migración pendiente a
         Microsoft.NET.Sdk.Razor en la fase de Testing) invoque los
         miembros internal de UsagePollingCoordinator/UsagePage
         (PollOnceForTestsAsync, ApplyForTests, etc.) sin esperar 60s reales
         por ciclo de test — mismo patrón ya usado por
         ClaudeMeter.ConsoleApp con ClaudeMeter.Console.Tests. -->
    <InternalsVisibleTo Include="ClaudeMeter.Desktop.Tests" />
  </ItemGroup>

</Project>
